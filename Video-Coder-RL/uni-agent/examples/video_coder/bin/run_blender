#!/usr/bin/env bash
# Agent-facing wrapper: execute a bpy script with Blender 4.5 in the current directory (it renders the video here).
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"
py="${VCSFT_PYTHON:-$root/.venv/bin/python}"
PYTHONPATH="$root${PYTHONPATH:+:$PYTHONPATH}" exec "$py" -m vcsft.blender_exec "$@"
